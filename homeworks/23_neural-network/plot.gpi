# plot.gpi 

set terminal svg background rgb "white" size 1200,700 dynamic enhanced font 'Verdena,11'
set output 'ann_results.svg'

set multiplot layout 2, 2 title "Neural Nework Function Approximation Visualisation" font 'Verdena,14' \
    margins 0.07, 0.93, 0.08, 0.90 spacing 0.06, 0.05

# =====================================================================
# ROW 1, COL 1: Task A - Function Fit
# =====================================================================
set title "ANN interpolation using Gaussian wavelets"
set xlabel ""
set ylabel "g(x)" offset 1, 0
set grid lc rgb "#e0e0e0"
set key top left

plot 'ann_interpolation.dat' using 1:2 with lines lw 2.5 lc rgb "purple" title "Exact g(x)", \
     'ann_interpolation.dat' using 1:3 with lines lw 2.5 dt 2 lc rgb "light-green" title "ANN g(x)", \
     'training_points.dat' using 1:2 with points pt 7 ps 0.8 lc rgb "black" title "Training points"

# =====================================================================
# ROW 1, COL 2: Task B - Derivatives & Anti-Derivative Fit
# =====================================================================
set title "Exact calculus comparison"
set xlabel ""
set ylabel "Derivatives"
set grid lc rgb "#e0e0e0"

set y2label "Anti-derivative" offset -1, 0
set y2tics
set key bottom right
set y2range [-0.3:0.3]

plot "ann_calculus.dat" using 1:5 with lines title "Exact g'(x)" lw 2.5 lc rgb "dark-green", \
     "ann_calculus.dat" using 1:4 with lines title "ANN g'(x)" lw 2.5 dt 2 lc rgb "magenta", \
     "ann_calculus.dat" using 1:7 with lines title "Exact g''(x)" lw 2.5 lc rgb "orange", \
     "ann_calculus.dat" using 1:6 with lines title "ANN g''(x)" lw 2.5 dt 2 lc rgb "brown", \
     "ann_calculus.dat" using 1:9 with lines title "num. Exact ∫g(x) [R]" lw 2.5 lc rgb "blue" axes x1y2, \
     "ann_calculus.dat" using 1:8 with lines title "ANN ∫g(x) [R]" lw 2.5 dt 2 lc "red" axes x1y2

title_saved = ""
set y2label ""
unset y2tics

# =====================================================================
# ROW 2, COL 1: Task A - Deviation Plot
# =====================================================================
set title ""
set xlabel "x"
set ylabel "Absolute error (Exact - ANN)"
set grid lc rgb "#e0e0e0"

set logscale y
set yrange [* : 10^0]
set format y "10^{%L}"

set xzeroaxis lt 1 lc rgb "#808080" lw 1 
set key top center

plot 'ann_interpolation.dat' using 1:(abs($2-$3) + 1e-8) with lines lw 2.5 lc rgb "purple" title "g(x) error"

# =====================================================================
# ROW 2, COL 2: Task B - Derivatives Deviation Plot
# =====================================================================
set title ""
set xlabel "x"
set ylabel "Absolute error (Exact - ANN)"
set grid lc rgb "#e0e0e0"

set logscale y
set format y "10^{%L}"

set xzeroaxis lt 1 lc rgb "#808080" lw 1
set key top center

plot "ann_calculus.dat" using 1:(abs($5-$4) + 1e-8) with lines title "|g'(x) error|" lw 2.5 lc rgb "dark-green", \
     "ann_calculus.dat" using 1:(abs($7-$6) + 1e-8) with lines title "|g''(x) error|" lw 2.5 lc rgb "orangee", \
     "ann_calculus.dat" using 1:(abs($9-$8) + 1e-8) with lines title "|∫g(x) error|" lw 2.5 lc rgb "blue"
unset logscale y
unset multiplot

# Written with the help of AI (Gemini 3.5 Flash)
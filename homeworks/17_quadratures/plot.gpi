# plot.gpi

# ========================================
# A.4 - PLOT OF IMPLEMENTED ERF
# ========================================

set terminal pngcairo size 900,700
set output "erf_function.png"

set xrange [-4:4]

# FIXED layout control
set multiplot layout 2,1 \
    title "Plot of implemented erf (erf\\\_integral with acc = eps = 0.001) and inbuilt erf (std::erf)" \
    margins 0.15,0.92,0.10,0.92 spacing 0.08


# TOP: erf(z)
set ylabel "erf(z)"
set key right bottom

plot \
"erf_function.dat" using 1:2 with lines title "erf\\\_integral(z, 0.001, 0.001)", \
"erf_function.dat" using 1:3 with lines title "std::erf(z)"


# BOTTOM: error
set xlabel "z"
set ylabel "absolute error"

set logscale y
set yrange [1e-12:*]

plot \
"erf_function.dat" using 1:4 with lines lc rgb "red" title "absolute error", \
"erf_function.dat" using 1:5 with lines lc rgb "blue" dt 2 title "local tolerance target"

unset multiplot

# ========================================
# A.6 - CONVERGENCE STUDY FOR ERF(1.0)
# ========================================

reset
set terminal pngcairo size 800,600
set output "erf_convergence.png"

set logscale xy
set xlabel "acc"
set ylabel "|val - exact|"
set key right bottom

set title "Error convergence of erf(1)"

plot "erf_convergence.dat" using 1:2 with linespoints title "adaptive quadrature"

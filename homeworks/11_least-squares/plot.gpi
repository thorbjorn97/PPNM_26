# "plot.gpi" script

set terminal svg background rgb "white" size 750, 600 enhanced font "Arial,14"

# =====================================================
# TASK A: Plot fit with errorbars
# =====================================================

set output "ThX_fit_A.svg"

set title "Radioactive decay of ThX (Rutherford and Soddy, 1902)"
set xlabel "Time t [days]"
set ylabel "Activity y [relative units]"

set grid
set key top right

# Plot data and QR fit
plot \
    "ThX.dat" u 1:2:3 w yerrorbars pt 7 ps 1 lc rgb "black" lw 1.5 title "Data with uncertainty", \
    "fit.dat" u 1:2 w lines lw 1.5 lc rgb "red" title "Best QR Fit"

unset output


# =====================================================
# TASK C: Add boundary combinations of uncertainties
# =====================================================

set output "ThX_fit_C.svg"

set title "Radioactive decay of ThX (Rutherford and Soddy, 1902)"
set xlabel "Time t [days]"
set ylabel "Activity y [relative units]"

set grid
set key top right

# Plot data, best QR fit and the 4 boundary combinations
plot \
    "ThX.dat" u 1:2:3 w yerrorbars pt 7 ps 1 lc rgb "black" lw 1.5 title "Data with uncertainty", \
    "fit_bounds.dat" u 1:2 w lines dt 2 lc rgb "#849924" title "(ĉ_0 + {/Symbol d}c_0, ĉ_1 + {/Symbol d}c_1)", \
    "fit_bounds.dat" u 1:3 w lines dt 2 lc rgb "#2f56d8" title "(ĉ_0 + {/Symbol d}c_0, ĉ_1 - {/Symbol d}c_1)", \
    "fit_bounds.dat" u 1:4 w lines dt 2 lc rgb "#a73fc7" title "(ĉ_0 - {/Symbol d}c_0, ĉ_1 + {/Symbol d}c_1)", \
    "fit_bounds.dat" u 1:5 w lines dt 2 lc rgb "#e96e1d" title "(ĉ_0 - {/Symbol d}c_0, ĉ_1 - {/Symbol d}c_1)", \
    "fit.dat" u 1:2 w lines lw 1.5 lc rgb "red" title "Best QR Fit (ĉ_0, ĉ_1)"

unset output
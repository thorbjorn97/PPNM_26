# plot_dif.gpi

set terminal svg background rgb "white"
set output "splines_deviations.svg"

set xrange [0:9]
set yrange [*:*]
set tics out

set key top right
set key vertical width 1 height 1 spacing 1

set title "Spline Interpolation Error: S(x) - cos(x)" font ",18 bold"
set xlabel "x" font ",14"
set ylabel "Deviation" font ",14"

plot \
"exact.dat" using 1:(0) with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"nodes.dat" using 1:(0) with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"out_lin.dat" using 1:4 with lines lc rgb "red" lw 2 title "Linear", \
"out_quad.dat" using 1:5 with lines lc rgb "blue" lw 2 title "Quadratic (OOP)", \
"out_func.dat" using 1:3 with lines lc rgb "green" lw 2 dt 2 title "Quadratic (functional)", \
"out_cubic.dat" using 1:5 with lines lc rgb "purple" lw 2 title "Cubic (OOP)"


# plot.gpi

set terminal svg background rgb "white" size 1000,1400
set output "splines_results.svg"

set xrange [-2:9]
set yrange [-1:1]
set tics out

set key bottom left Left reverse
set key vertical width 1 height 1 spacing 1

set multiplot layout 5,1 title "Spline Interpolations of cos(x)" font ",20 bold"


# =========================================================
# 1. Linear spline
# =========================================================
set title "Task A: Linear spline" font ",16"

plot \
"exact.dat" using 1:2 with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"exact.dat" using 1:3 with lines lc rgb "black" lw 1 dt 4 title "sin(x)", \
"nodes.dat" using 1:2 with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"out_lin.dat" using 1:2 with lines lc rgb "red" lw 2 title "Linear spline", \
"out_lin.dat" using 1:3 with lines lc rgb "purple" lw 2 title "Integral"


# =========================================================
# 2. Quadratic spline (OOP)
# =========================================================
set title "Task B: Quadratic spline (OOP)" font ",16"

plot \
"exact.dat" using 1:2 with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"exact.dat" using 1:3 with lines lc rgb "black" lw 1 dt 4 title "sin(x)", \
"exact.dat" using 1:4 with lines lc rgb "black" lw 1 dt 5 title "-sin(x)", \
"nodes.dat" using 1:2 with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"out_quad.dat" using 1:2 with lines lc rgb "red" lw 2 title "Quadratic spline", \
"out_quad.dat" using 1:3 with lines lc rgb "purple" lw 2 title "Integral", \
"out_quad.dat" using 1:4 with lines lc rgb "blue" lw 2 title "Derivative"


# =========================================================
# 3. Quadratic spline (functional)
# =========================================================
set title "Task C: Quadratic spline (functional)" font ",16"

plot \
"exact.dat" using 1:2 with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"exact.dat" using 1:3 with lines lc rgb "black" lw 1 dt 4 title "sin(x)", \
"nodes.dat" using 1:2 with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"out_func.dat" using 1:2 with lines lc rgb "red" lw 2 title "Quadratic spline"


# =========================================================
# 4. Cubic spline (OOP)
# =========================================================
set title "Task C: Cubic spline (OOP)" font ",16"

plot \
"exact.dat" using 1:2 with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"exact.dat" using 1:3 with lines lc rgb "black" lw 1 dt 4 title "sin(x)", \
"exact.dat" using 1:4 with lines lc rgb "black" lw 1 dt 5 title "-sin(x)", \
"nodes.dat" using 1:2 with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"out_cubic.dat" using 1:2 with lines lc rgb "red" lw 2 title "Cubic spline", \
"out_cubic.dat" using 1:3 with lines lc rgb "purple" lw 2 title "Integral", \
"out_cubic.dat" using 1:4 with lines lc rgb "blue" lw 2 title "Derivative"


# =========================================================
# 5. Cubic spline (in-built)
# =========================================================
set title "Task C: Cubic spline (in-built)" font ",16"

plot \
"exact.dat" using 1:2 with lines lc rgb "black" lw 1 dt 2 title "cos(x)", \
"exact.dat" using 1:3 with lines lc rgb "black" lw 1 dt 4 title "sin(x)", \
"nodes.dat" using 1:2 with points pt 7 ps 1.2 lc rgb "black" title "Nodes", \
"nodes.dat" using 1:2 smooth csplines lw 2 lc rgb "red" title "Cubic spline"

unset multiplot

